# Plantilla de variables de entorno para desarrollo local.
# Copia este archivo a ".env" y ajusta los valores antes de ejecutar la aplicación.
# IMPORTANTE: Nunca agregues credenciales o claves reales de producción a este archivo.

# --- Base de Datos PostgreSQL (Docker Compose) ---
POSTGRES_DB=posdb_dev
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospass

# --- Backend Spring Boot ---
SPRING_PROFILES_ACTIVE=dev

# Conexión JDBC (Requerido en producción, en dev usa fallbacks locales si no se define)
DATABASE_URL=jdbc:postgresql://localhost:5432/posdb_dev
DATABASE_USER=posuser
DATABASE_PASSWORD=pospass

# Autenticación JWT
JWT_SECRET=Ptt-k@uuaii-JWT-S3cr3t-K3y-256-b1ts-M1n1mum!
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
